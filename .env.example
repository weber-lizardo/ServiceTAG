# Projeto Supabase (Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a service_role key: ela fica só no servidor, nunca vai para o navegador
SUPABASE_SERVICE_ROLE_KEY=

# Porta do servidor web
PORT=3000

# Defina HEADLESS=false para ver o navegador abrindo o site da Dell
HEADLESS=true
# Opcional: caminho de um Chromium/Chrome já instalado
# CHROMIUM_PATH=/usr/bin/google-chrome
