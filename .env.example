# Só para rodar o worker localmente (npm run consultar).
# No GitHub Actions, estes valores vêm das variáveis/secrets do repositório.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Defina HEADLESS=false para ver o navegador abrindo o site da Dell
HEADLESS=true
# Opcional: caminho de um Chromium/Chrome já instalado
# CHROMIUM_PATH=/usr/bin/google-chrome
